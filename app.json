{
  "expo": {
    "name": "BoxLedger",
    "slug": "boxledger",
    "scheme": "boxledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.boxledger.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Take a photo of each item when you add it to inventory, and scan barcodes.",
        "NSPhotoLibraryUsageDescription": "Pick photos of items you already took, to attach to an inventory entry.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cyan0914.boxledger",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Scan barcodes for inventory items."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach a photo to an inventory item.",
          "cameraPermission": "Take a photo of an inventory item."
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A7549",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ]
  }
}
